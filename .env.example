# ─── Supabase (Phase 1: authentication + PostgreSQL) ────────────────────────
# Create a free project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI provider (Phase 5: AI integration — server-side only) ───────────────
# Provider-independent adapter. Example for OpenAI-compatible providers:
# AI_PROVIDER=openai
# AI_MODEL=gpt-5
# AI_API_KEY=            # NEVER expose this to the client bundle
# AI_BASE_URL=           # optional override for alternative providers
